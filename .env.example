# Elysium Academy — backend environment template.
# Copy to .env and fill in real values.  NEVER commit the real .env.
FLASK_DEBUG=false

# Secrets — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_EXPIRES_HOURS=24
JWT_REFRESH_DAYS=30

# Database (SQLAlchemy URL)
DATABASE_URL=mysql+pymysql://user:password@localhost/elysium_db

# CORS — comma-separated allowed origins (your frontend URLs); * allows all
CORS_ORIGINS=https://yourdomain.com

# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://

# Public site URL (used in email links)
SITE_URL=https://yourdomain.com

# Email / SMTP (leave blank to disable email sending)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=you@gmail.com
MAIL_FROM_NAME=Elysium Academy
ADMIN_ALERT_EMAIL=admin@yourdomain.com
